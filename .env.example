# ============================================================================
# TRANSCENDANCE - ENVIRONMENT CONFIGURATION / CONFIGURATION D'ENVIRONNEMENT
# ============================================================================
# This file contains all environment variables needed for the project.
# Copy this file to .env and fill in the values.
#
# Ce fichier contient toutes les variables d'environnement nécessaires au projet.
# Copiez ce fichier vers .env et remplissez les valeurs.
# ============================================================================

# ----------------------------------------------------------------------------
# GENERAL CONFIGURATION / CONFIGURATION GÉNÉRALE
# ----------------------------------------------------------------------------
# NODE_ENV: Environment mode (DEV, PROD, TEST)
# NODE_ENV: Mode d'environnement (DEV, PROD, TEST)
NODE_ENV="DEV"

# HOME: Home directory path for the application (use $HOME for current user)
# HOME: Chemin du répertoire personnel pour l'application (utiliser $HOME pour l'utilisateur actuel)
HOME=$HOME


# ----------------------------------------------------------------------------
# MESSAGE BROKER - RABBITMQ
# ----------------------------------------------------------------------------
# RabbitMQ is used for inter-service communication in the microservices architecture.
# RabbitMQ est utilisé pour la communication entre services dans l'architecture microservices.

# RABBITMQ_DEFAULT_USER: Default username for RabbitMQ
# RABBITMQ_DEFAULT_USER: Nom d'utilisateur par défaut pour RabbitMQ
RABBITMQ_DEFAULT_USER="gt_rabbit_admin"

# RABBITMQ_DEFAULT_PASS: Default password for RabbitMQ (generate strong password)
# RABBITMQ_DEFAULT_PASS: Mot de passe par défaut pour RabbitMQ (générer un mot de passe fort)
RABBITMQ_DEFAULT_PASS="your_strong_rabbitmq_password"


# ----------------------------------------------------------------------------
# SECURITY - SECRETS / SÉCURITÉ - SECRETS
# ----------------------------------------------------------------------------
# These secrets are used for JWT tokens, cookies, and CSRF protection.
# IMPORTANT: Generate strong random strings for production!
#
# Ces secrets sont utilisés pour les tokens JWT, les cookies et la protection CSRF.
# IMPORTANT: Générez des chaînes aléatoires fortes pour la production!

# JWT_SECRET: Secret key for JWT token signing (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
# JWT_SECRET: Clé secrète pour la signature des tokens JWT (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
JWT_SECRET="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"

# COOKIE_SECRET: Secret key for cookie encryption (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
# COOKIE_SECRET: Clé secrète pour le chiffrement des cookies (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
COOKIE_SECRET="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"

# CSRF_SECRET: Secret key for CSRF token generation (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
# CSRF_SECRET: Clé secrète pour la génération des tokens CSRF (format: XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
CSRF_SECRET="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"


# ----------------------------------------------------------------------------
# DATABASE - POSTGRESQL
# ----------------------------------------------------------------------------
# PostgreSQL database credentials for services requiring persistent storage.
# Identifiants de la base de données PostgreSQL pour les services nécessitant un stockage persistant.

# POSTGRES_USER: PostgreSQL username
# POSTGRES_USER: Nom d'utilisateur PostgreSQL
POSTGRES_USER=transcendance_user

# POSTGRES_PASSWORD: PostgreSQL password
# POSTGRES_PASSWORD: Mot de passe PostgreSQL
POSTGRES_PASSWORD=transcendance_pwd

# POSTGRES_DB: PostgreSQL database name
# POSTGRES_DB: Nom de la base de données PostgreSQL
POSTGRES_DB=transcendance_db


# ----------------------------------------------------------------------------
# CACHE - REDIS
# ----------------------------------------------------------------------------
# Redis is used for caching and session management.
# Redis est utilisé pour le cache et la gestion des sessions.

# REDIS_PASSWORD: Password for Redis authentication
# REDIS_PASSWORD: Mot de passe pour l'authentification Redis
REDIS_PASSWORD="redis_password"

# REDIS_HOST: Redis server hostname (use service name in Docker)
# REDIS_HOST: Nom d'hôte du serveur Redis (utilisez le nom du service dans Docker)
REDIS_HOST="redis"

# REDIS_PORT: Redis server port (default: 6379)
# REDIS_PORT: Port du serveur Redis (par défaut: 6379)
REDIS_PORT=6379


# ----------------------------------------------------------------------------
# AUTHENTICATION - OAUTH 2.0
# ----------------------------------------------------------------------------
# OAuth 2.0 configuration for external authentication providers.
# Configuration OAuth 2.0 pour les fournisseurs d'authentification externes.

# LENGTH_OF_STATE: Length of the OAuth state parameter for security
# LENGTH_OF_STATE: Longueur du paramètre state OAuth pour la sécurité
LENGTH_OF_STATE=16

# OAUTH42_USER_INFO_URL: 42 API endpoint for user information
# OAUTH42_USER_INFO_URL: Point de terminaison de l'API 42 pour les informations utilisateur
OAUTH42_USER_INFO_URL=https://api.intra.42.fr/v2/me

# OAUTH42_AUTHORIZE_URL: 42 OAuth authorization endpoint
# OAUTH42_AUTHORIZE_URL: Point de terminaison d'autorisation OAuth de 42
OAUTH42_AUTHORIZE_URL=https://api.intra.42.fr/oauth/authorize

# OAUTH42_TOKEN_URL: 42 OAuth token endpoint
# OAUTH42_TOKEN_URL: Point de terminaison de token OAuth de 42
OAUTH42_TOKEN_URL=https://api.intra.42.fr/oauth/token

# OAUTH42_UID: 42 OAuth application UID (get from 42 intra)
# OAUTH42_UID: UID de l'application OAuth 42 (obtenir depuis 42 intra)
OAUTH42_UID=your_42_app_uid

# OAUTH42_SECRET: 42 OAuth application secret (get from 42 intra)
# OAUTH42_SECRET: Secret de l'application OAuth 42 (obtenir depuis 42 intra)
OAUTH42_SECRET=your_42_app_secret


# ----------------------------------------------------------------------------
# AUTHENTICATION - 42 (ALTERNATIVE NAMING)
# ----------------------------------------------------------------------------
# Alternative naming convention for 42 OAuth credentials.
# Convention de nommage alternative pour les identifiants OAuth de 42.

# FORTYTWO_CLIENT_ID: 42 OAuth client ID (same as OAUTH42_UID)
# FORTYTWO_CLIENT_ID: ID client OAuth de 42 (identique à OAUTH42_UID)
FORTYTWO_CLIENT_ID=your_42_client_id

# FORTYTWO_CLIENT_SECRET: 42 OAuth client secret (same as OAUTH42_SECRET)
# FORTYTWO_CLIENT_SECRET: Secret client OAuth de 42 (identique à OAUTH42_SECRET)
FORTYTWO_CLIENT_SECRET=your_42_client_secret

# FORTYTWO_REDIRECT_URI: OAuth callback URL for 42 authentication
# FORTYTWO_REDIRECT_URI: URL de callback OAuth pour l'authentification 42
FORTYTWO_REDIRECT_URI=https://localhost/auth/42/callback


# ----------------------------------------------------------------------------
# LOGGING - ELK STACK (ELASTICSEARCH, LOGSTASH, KIBANA)
# ----------------------------------------------------------------------------
# ELK Stack configuration for centralized logging and monitoring.
# Configuration de la pile ELK pour la journalisation et la surveillance centralisées.
#
# IMPORTANT: The ELASTIC_USERNAME should NOT be changed. It's a default user.
# Changing it causes conflicts during container installation.
#
# IMPORTANT: Le ELASTIC_USERNAME ne doit PAS être changé. C'est un utilisateur par défaut.
# Le changer cause des conflits lors de l'installation des conteneurs.

# ELASTIC_USERNAME: Elasticsearch username (DO NOT CHANGE - use default 'elastic')
# ELASTIC_USERNAME: Nom d'utilisateur Elasticsearch (NE PAS CHANGER - utiliser 'elastic' par défaut)
ELASTIC_USERNAME=elastic

# ELASTIC_PASSWORD: Elasticsearch password (minimum 6 characters)
# ELASTIC_PASSWORD: Mot de passe Elasticsearch (minimum 6 caractères)
ELASTIC_PASSWORD=your_elastic_password


# ----------------------------------------------------------------------------
# NETWORK - PORTS / RÉSEAU - PORTS
# ----------------------------------------------------------------------------
# Port configuration for external access to services.
# Configuration des ports pour l'accès externe aux services.

# PORT_NGINX_HTTP: Nginx HTTP port (default: 80, example: 18888)
# PORT_NGINX_HTTP: Port HTTP de Nginx (par défaut: 80, exemple: 18888)
PORT_NGINX_HTTP=18888

# PORT_NGINX_HTTPS: Nginx HTTPS port (default: 443, example: 18443)
# Example: Access the web app at https://localhost:18443
#
# PORT_NGINX_HTTPS: Port HTTPS de Nginx (par défaut: 443, exemple: 18443)
# Exemple: Accéder à l'application web sur https://localhost:18443
PORT_NGINX_HTTPS=18443

# PORT_KIBANA: Kibana dashboard port (default: 5601, example: 15601)
# PORT_KIBANA: Port du tableau de bord Kibana (par défaut: 5601, exemple: 15601)
PORT_KIBANA=15601

# PORT_POSTGRES: PostgreSQL external port (default: 5432, example: 15432)
# NOTE: This port may be commented in the docker-compose.yml file
# The site should only be accessible via nginx, not directly via services
#
# PORT_POSTGRES: Port externe PostgreSQL (par défaut: 5432, exemple: 15432)
# NOTE: Ce port peut être commenté dans le fichier docker-compose.yml
# Le site doit être uniquement accessible via nginx et pas directement via les services
PORT_POSTGRES=15432


# ----------------------------------------------------------------------------
# NETWORK - IP CONFIGURATION / RÉSEAU - CONFIGURATION IP
# ----------------------------------------------------------------------------
# IP address configuration for external access (VM/Remote access).
# Configuration des adresses IP pour l'accès externe (VM/Accès distant).

# ALLOWED_IP_HOST_CASE_VM: IP address for VM host access
# This is used to specify the IP for accessing the site from an external machine.
# It is automatically filled by the script /orchestration/find_ip.sh
#
# ALLOWED_IP_HOST_CASE_VM: Adresse IP pour l'accès hôte VM
# Sert à indiquer l'IP pour accéder au site depuis une machine extérieure.
# Il est rempli automatiquement par le script /orchestration/find_ip.sh
ALLOWED_IP_HOST_CASE_VM=10.12.2.10

# ALLOWED_IP: Allowed IP address for access control (auto-detected)
# ALLOWED_IP: Adresse IP autorisée pour le contrôle d'accès (auto-détectée)
ALLOWED_IP=10.0.2.15


# ----------------------------------------------------------------------------
# MICROSERVICES - INTERNAL PORTS / MICROSERVICES - PORTS INTERNES
# ----------------------------------------------------------------------------
# Internal port configuration for microservices communication.
# These ports are used within the Docker network.
#
# Configuration des ports internes pour la communication entre microservices.
# Ces ports sont utilisés au sein du réseau Docker.

# AUTH_SERVICE_PORT: Authentication service port
# AUTH_SERVICE_PORT: Port du service d'authentification
AUTH_SERVICE_PORT=3000

# LANGUAGE_MANAGER_SERVICE_PORT: Language manager service port
# LANGUAGE_MANAGER_SERVICE_PORT: Port du service de gestion des langues
LANGUAGE_MANAGER_SERVICE_PORT=3001

# LIVE_CHAT_SERVICE_PORT: Live chat service port
# LIVE_CHAT_SERVICE_PORT: Port du service de chat en direct
LIVE_CHAT_SERVICE_PORT=3002

# REMOTE_PLAYER_SERVICE_PORT: Remote player service port
# REMOTE_PLAYER_SERVICE_PORT: Port du service de joueur distant
REMOTE_PLAYER_SERVICE_PORT=3003

# MATCH_MAKING_PORT: Match making service port
# MATCH_MAKING_PORT: Port du service de matchmaking
MATCH_MAKING_PORT=3004

# SERVER-RENDERING_PORT: Server-side rendering service port
# SERVER-RENDERING_PORT: Port du service de rendu côté serveur
SERVER-RENDERING_PORT=3003


# ----------------------------------------------------------------------------
# BLOCKCHAIN - AVALANCHE
# ----------------------------------------------------------------------------
# Blockchain configuration for storing tournament scores on Avalanche network.
# Configuration blockchain pour stocker les scores de tournois sur le réseau Avalanche.

# BLOCKCHAIN_WALLET_ADDRESS: Wallet address for blockchain transactions
# BLOCKCHAIN_WALLET_ADDRESS: Adresse du portefeuille pour les transactions blockchain
BLOCKCHAIN_WALLET_ADDRESS=

# BLOCKCHAIN_PRIVATE_KEY: Private key for blockchain wallet (KEEP SECRET!)
# BLOCKCHAIN_PRIVATE_KEY: Clé privée pour le portefeuille blockchain (GARDER SECRET!)
BLOCKCHAIN_PRIVATE_KEY=

# BLOCKCHAIN_RPC_URL: Avalanche RPC endpoint URL
# BLOCKCHAIN_RPC_URL: URL du point de terminaison RPC Avalanche
BLOCKCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# BLOCKCHAIN_NETWORK_ID: Avalanche network ID (Fuji testnet: 43113, Mainnet: 43114)
# BLOCKCHAIN_NETWORK_ID: ID du réseau Avalanche (Testnet Fuji: 43113, Mainnet: 43114)
BLOCKCHAIN_NETWORK_ID=43113


# ----------------------------------------------------------------------------
# EMAIL SERVICE / SERVICE DE MESSAGERIE
# ----------------------------------------------------------------------------
# Email service configuration for sending notifications and account emails.
# Configuration du service de messagerie pour l'envoi de notifications et emails de compte.

# MAIL_HOST: SMTP server hostname
# MAIL_HOST: Nom d'hôte du serveur SMTP
MAIL_HOST=smtp.gmail.com

# MAIL_PORT: SMTP server port (587 for TLS, 465 for SSL)
# MAIL_PORT: Port du serveur SMTP (587 pour TLS, 465 pour SSL)
MAIL_PORT=587

# MAIL_USER: Email account username
# MAIL_USER: Nom d'utilisateur du compte email
MAIL_USER=your_email@example.com

# MAIL_PASSWORD: Email account password or app-specific password
# MAIL_PASSWORD: Mot de passe du compte email ou mot de passe d'application
MAIL_PASSWORD=your_email_password

# MAIL_FROM: Default sender email address
# MAIL_FROM: Adresse email de l'expéditeur par défaut
MAIL_FROM=noreply@transcendance.com


# ============================================================================
# END OF CONFIGURATION / FIN DE LA CONFIGURATION
# ============================================================================
# Make sure to keep this file secure and never commit it to version control!
# Add .env to your .gitignore file.
#
# Assurez-vous de sécuriser ce fichier et de ne jamais le commiter dans le contrôle de version!
# Ajoutez .env à votre fichier .gitignore.
# ============================================================================
