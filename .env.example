# ============================================================================
# TRANSCENDANCE - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables needed for the project.
# Copy this file to srcs/.env and fill in the values.
# ============================================================================

# ----------------------------------------------------------------------------
# GENERAL CONFIGURATION
# ----------------------------------------------------------------------------
# NODE_ENV: Environment mode (development, production, test)
NODE_ENV="PROD"

# HOME: Home directory path for the application
HOME=$HOME


# ----------------------------------------------------------------------------
# VAULT - SECRET MANAGEMENT
# ----------------------------------------------------------------------------
# HashiCorp Vault is used for secure secret storage and management.

# VAULT_ADDR: Vault server address
VAULT_ADDR=http://vault:8200

# VAULT_ROOT_TOKEN: Root token for Vault (generated by vaultInit.sh)
# This will be automatically populated when running 'make vault'
VAULT_ROOT_TOKEN=your_vault_root_token_here

# UNSEAL: Unseal key for Vault (generated by vaultInit.sh)
# This will be automatically populated when running 'make vault'
UNSEAL=your_unseal_key_here


# ----------------------------------------------------------------------------
# MESSAGE BROKER - RABBITMQ
# ----------------------------------------------------------------------------
# RabbitMQ is used for inter-service communication in the microservices architecture.

# RABBITMQ_DEFAULT_USER: Default username for RabbitMQ
RABBITMQ_DEFAULT_USER="gt_rabbit_admin"

# RABBITMQ_DEFAULT_PASS: Default password for RabbitMQ
RABBITMQ_DEFAULT_PASS="your_rabbitmq_password_here"


# ----------------------------------------------------------------------------
# AUTHENTICATION - 42 OAUTH
# ----------------------------------------------------------------------------
# 42 OAuth configuration for external authentication.

# FORTYTWO_CLIENT_ID: 42 OAuth client ID (get from 42 intra)
FORTYTWO_CLIENT_ID=your_42_client_id_here

# FORTYTWO_CLIENT_SECRET: 42 OAuth client secret (get from 42 intra)
FORTYTWO_CLIENT_SECRET=your_42_client_secret_here

# FORTYTWO_REDIRECT_URI: OAuth callback URL for 42 authentication
FORTYTWO_REDIRECT_URI=https://localhost/auth/42/callback


# ----------------------------------------------------------------------------
# CACHE - REDIS
# ----------------------------------------------------------------------------
# Redis is used for caching and session management.

# REDIS_PASSWORD: Password for Redis authentication
REDIS_PASSWORD="your_redis_password_here"

# REDIS_HOST: Redis server hostname (use service name in Docker)
REDIS_HOST="redis"

# REDIS_PORT: Redis server port (default: 6379)
REDIS_PORT=6379


# ----------------------------------------------------------------------------
# DATABASE - POSTGRESQL
# ----------------------------------------------------------------------------
# PostgreSQL database credentials for services requiring persistent storage.

# POSTGRES_USER: PostgreSQL username
POSTGRES_USER=transcendance_user

# POSTGRES_PASSWORD: PostgreSQL password
POSTGRES_PASSWORD=your_postgres_password_here

# POSTGRES_DB: PostgreSQL database name
POSTGRES_DB=transcendance_db


# ----------------------------------------------------------------------------
# SECURITY - SECRETS
# ----------------------------------------------------------------------------
# These secrets are used for JWT tokens, cookies, and CSRF protection.
# IMPORTANT: Generate strong random strings for production!

# JWT_SECRET: Secret key for JWT token signing (min 32 characters recommended)
JWT_SECRET="your_jwt_secret_key_min_32_characters"

# COOKIE_SECRET: Secret key for cookie encryption
COOKIE_SECRET="your_cookie_secret_key"

# CSRF_SECRET: Secret key for CSRF token generation
CSRF_SECRET="your_csrf_secret_key"


# ----------------------------------------------------------------------------
# OAUTH STATE
# ----------------------------------------------------------------------------
# LENGTH_OF_STATE: Length of the OAuth state parameter for security
LENGTH_OF_STATE=16


# ----------------------------------------------------------------------------
# LOGGING - ELK STACK (ELASTICSEARCH, LOGSTASH, KIBANA)
# ----------------------------------------------------------------------------
# ELK Stack configuration for centralized logging and monitoring.
#
# IMPORTANT: The ELASTIC_USERNAME must NOT be changed (default user).
# Changing it causes container install conflicts.

# ELASTIC_USERNAME: Elasticsearch username (DO NOT CHANGE - use default 'elastic')
ELASTIC_USERNAME=elastic

# ELASTIC_PASSWORD: Elasticsearch password (minimum 6 characters)
ELASTIC_PASSWORD=your_elastic_password_here


# ----------------------------------------------------------------------------
# NETWORK - PORTS
# ----------------------------------------------------------------------------
# Port configuration for external access to services.

# PORT_NGINX_HTTP: Nginx HTTP port
PORT_NGINX_HTTP=18888

# PORT_NGINX_HTTPS: Nginx HTTPS port
# Example: Access the web app at https://localhost:18443
PORT_NGINX_HTTPS=18443

# PORT_KIBANA: Kibana dashboard port
PORT_KIBANA=15601

# PORT_POSTGRES: PostgreSQL external port
PORT_POSTGRES=15432


# ----------------------------------------------------------------------------
# NETWORK - IP CONFIGURATION
# ----------------------------------------------------------------------------
# IP address configuration for external access (VM/Remote access).

# ALLOWED_IP_HOST_CASE_VM: IP address for VM host access
# This is used to specify the IP for accessing the site from an external machine.
# It is automatically filled by the script /orchestration/find_ip.sh
ALLOWED_IP_HOST_CASE_VM=10.12.2.10

# ALLOWED_IP: Allowed IP address for access control
# IP for accessing the site from an external machine; set by /orchestration/find_ip.sh
ALLOWED_IP=10.0.2.15


# ----------------------------------------------------------------------------
# MICROSERVICES - INTERNAL PORTS
# ----------------------------------------------------------------------------
# Internal port configuration for microservices communication.
# These ports are used within the Docker network.

# AUTH_SERVICE_PORT: Authentication service port
AUTH_SERVICE_PORT=3000

# LANGUAGE_MANAGER_SERVICE_PORT: Language manager service port
LANGUAGE_MANAGER_SERVICE_PORT=3001

# LIVE_CHAT_SERVICE_PORT: Live chat service port
LIVE_CHAT_SERVICE_PORT=3002

# REMOTE_PLAYER_SERVICE_PORT: Remote player service port
REMOTE_PLAYER_SERVICE_PORT=3003

# MATCH_MAKING_PORT: Match making service port
MATCH_MAKING_PORT=3004

# SERVER_RENDERING_PORT: Server-side rendering service port
SERVER_RENDERING_PORT=3003


# ----------------------------------------------------------------------------
# MONITORING - GRAFANA
# ----------------------------------------------------------------------------
# Grafana configuration for monitoring and dashboards.

# GRAFANA_ADMIN_PASSWORD: Admin password for Grafana dashboard
GRAFANA_ADMIN_PASSWORD="your_grafana_admin_password_here"

# GRAFANA_PORT: External port for Grafana dashboard access
GRAFANA_PORT=3007


# ----------------------------------------------------------------------------
# ALERTING - DISCORD WEBHOOKS
# ----------------------------------------------------------------------------
# Discord webhooks for Prometheus alerts.
# Create webhooks in Discord: Server Settings > Integrations > Webhooks

# DISCORD_WEBHOOK_URL: Discord webhook URL for general/warning alerts
# Create a webhook and paste the URL here
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# DISCORD_WEBHOOK_CRITICAL: Discord webhook URL for critical alerts
# Optional: use a different channel for urgent alerts
DISCORD_WEBHOOK_CRITICAL="https://discord.com/api/webhooks/YOUR_CRITICAL_WEBHOOK_ID/YOUR_CRITICAL_WEBHOOK_TOKEN"


# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# Make sure to keep this file secure and never commit it to version control!
# Add srcs/.env to your .gitignore file.
# ============================================================================
