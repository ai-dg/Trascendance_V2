  {
    "compilerOptions": {
      "lib": ["es2024", "dom"],
      "target": "ESNext",
      "module": "ESNext",
      "rootDir": "./",
      "outDir": "../js",
      "moduleResolution": "node", 
      "checkJs": false,
      "forceConsistentCasingInFileNames": true,
      "esModuleInterop": true,
      "allowJs": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "declaration": false,
      "strict": true
    },
    "include": ["./**/*.ts"],
    "exclude": [
      "app/**/node_modules"
    ]
  }