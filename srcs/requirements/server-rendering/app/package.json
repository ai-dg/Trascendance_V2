  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.0",
    "ejs": "^3.1.10",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
