{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "../public/scripts/js",
    "rootDir": "../public/scripts/ts",
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["../public/scripts/ts"],
  "exclude": ["../../node_modules"]
}
