<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" class="size-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="api-base-url" content="<%= base_url %>">
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Play Retro Pong - Classic arcade game with local, AI, and remote multiplayer modes. Challenge friends or compete online!">
        <meta name="keywords" content="pong, retro game, multiplayer, arcade, online game">
        <title>Retro Pong - Classic Arcade Multiplayer Game</title>
        <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
        <link href="../public/styles/input.css" rel="stylesheet" />
    </head>

    <body class="size-full m-0 p-0">
        <!-- Server-rendered initial content for SEO - visible to search engines -->
        <div id="app">
            <header class="bg-black/80 p-4 border-b border-cyan-400">
                <h1 class="text-4xl font-bold text-center text-cyan-400">
                    <%= text && text.title ? text.title : 'RETRO PONG' %>
                </h1>
            </header>

            <main class="flex flex-col items-center justify-center min-h-screen p-8">
                <section class="max-w-4xl mx-auto text-center">
                    <h2 class="text-3xl font-bold text-cyan-400 mb-6">
                        <%= text && text.welcome ? text.welcome : 'Welcome to Retro Pong' %>
                    </h2>
                    <p class="text-xl text-white mb-8">
                        <%= text && text.description ? text.description : 'Classic arcade gaming experience with modern multiplayer features' %>
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
                        <article class="bg-black/60 border border-cyan-400 p-6 rounded-lg">
                            <h3 class="text-xl font-bold text-pink-500 mb-3">Local Play</h3>
                            <p class="text-white">Play against a friend on the same device</p>
                        </article>

                        <article class="bg-black/60 border border-cyan-400 p-6 rounded-lg">
                            <h3 class="text-xl font-bold text-pink-500 mb-3">AI Opponent</h3>
                            <p class="text-white">Challenge our intelligent AI player</p>
                        </article>

                        <article class="bg-black/60 border border-cyan-400 p-6 rounded-lg">
                            <h3 class="text-xl font-bold text-pink-500 mb-3">Online Multiplayer</h3>
                            <p class="text-white">Compete with players worldwide</p>
                        </article>
                    </div>

                    <noscript>
                        <div class="mt-8 p-4 bg-red-900/50 border border-red-400 rounded">
                            <p class="text-white">Please enable JavaScript to play Retro Pong</p>
                        </div>
                    </noscript>
                </section>
            </main>

            <footer class="bg-black/80 p-4 border-t border-cyan-400 text-center text-white">
                <p>&copy; 2026 Retro Pong. Built with ❤️ for the arcade era.</p>
            </footer>
        </div>

        <!-- Inline script to show loading screen ASAP (before modules load) -->
        <script>
            (function() {
                const loadingScreen = document.createElement('div');
                loadingScreen.id = 'app-loading';
                loadingScreen.style.cssText = 'position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;z-index:9999;';
                loadingScreen.innerHTML = '<div style="text-align:center;"><div style="font-size:3rem;color:#00ffff;font-family:monospace;font-weight:bold;margin-bottom:2rem;">RETRO PONG</div><div style="font-size:1.2rem;color:#ff1493;font-family:monospace;">Loading...</div></div>';
                document.body.appendChild(loadingScreen);
            })();
        </script>
        <!-- Debug: logs cumulatifs (localStorage) pour voir avant + après refresh -->
        <script>
            (function() {
                var MAX_LINES = 2000;
                var STORAGE_KEY = '__debugLogBuffer';
                var buffer = [];
                try {
                    var saved = localStorage.getItem(STORAGE_KEY);
                    if (saved) {
                        buffer = saved.split('\n').filter(Boolean);
                        if (buffer.length > MAX_LINES) buffer = buffer.slice(-MAX_LINES);
                    }
                } catch (e) {}
                function formatArgs(args) {
                    try {
                        return Array.prototype.map.call(args, function(a) {
                            if (typeof a === 'object') try { return JSON.stringify(a); } catch (e) { return String(a); }
                            return String(a);
                        }).join(' ');
                    } catch (e) { return String(args); }
                }
                function save() {
                    try { localStorage.setItem(STORAGE_KEY, buffer.join('\n')); } catch (e) {}
                }
                function push(level, args) {
                    var line = new Date().toISOString() + ' [' + level + '] ' + formatArgs(args);
                    buffer.push(line);
                    if (buffer.length > MAX_LINES) buffer = buffer.slice(-MAX_LINES);
                    save();
                }
                var origLog = console.log, origWarn = console.warn, origError = console.error;
                console.log = function() { push('LOG', arguments); return origLog.apply(console, arguments); };
                console.warn = function() { push('WARN', arguments); return origWarn.apply(console, arguments); };
                console.error = function() { push('ERROR', arguments); return origError.apply(console, arguments); };
                window.downloadDebugLog = function(filename) {
                    filename = filename || 'console-debug-' + new Date().toISOString().slice(0,19).replace(/:/g,'-') + '.txt';
                    var text = buffer.join('\n');
                    var blob = new Blob([text], { type: 'text/plain' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    a.style.display = 'none';
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(url); }, 200);
                    origLog.call(console, '[DEBUG] Téléchargement:', buffer.length, 'lignes (cumulatif) ->', filename);
                };
                window.copyDebugLog = function() {
                    var text = buffer.join('\n');
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).then(function() {
                            origLog.call(console, '[DEBUG]', buffer.length, 'lignes copiées (cumulatif).');
                        }).catch(function() {});
                    }
                };
                window.copyDebugLogRaw = function() { return buffer.join('\n'); };
                window.clearDebugLog = function() {
                    buffer = [];
                    save();
                    origLog.call(console, '[DEBUG] Logs effacés.');
                };
                origLog.call(console, '[DEBUG] Logs cumulatifs (survit au refresh). Export logs = bouton | clearDebugLog() = effacer. Pour refresh/cookies: chercher REFRESH_DEBUG dans l\'export.');
                var wrap = document.createElement('div');
                wrap.style.cssText = 'position:fixed;bottom:12px;right:12px;z-index:99999;display:flex;gap:6px;';
                var btn = document.createElement('button');
                btn.textContent = 'Export logs';
                btn.type = 'button';
                btn.style.cssText = 'padding:6px 12px;font-size:12px;background:#333;color:#0ff;border:1px solid #0ff;border-radius:4px;cursor:pointer;';
                btn.onclick = function() {
                    var fn = 'console-debug-' + new Date().toISOString().slice(0,19).replace(/:/g,'-') + '.txt';
                    var text = buffer.join('\n');
                    var blob = new Blob([text], { type: 'text/plain' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = fn;
                    a.style.display = 'none';
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(url); }, 500);
                };
                var btnClear = document.createElement('button');
                btnClear.textContent = 'Clear logs';
                btnClear.type = 'button';
                btnClear.style.cssText = 'padding:6px 12px;font-size:12px;background:#333;color:#f96;border:1px solid #f96;border-radius:4px;cursor:pointer;';
                btnClear.onclick = function() { clearDebugLog(); };
                wrap.appendChild(btn);
                wrap.appendChild(btnClear);
                document.body.appendChild(wrap);
            })();
        </script>

        <!-- Client-side JavaScript will hydrate this content -->
        <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
        <script type="module" src="../public/scripts/js/main.js"></script>
    </body>
</html>


